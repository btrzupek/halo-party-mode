[Unit]
Description=Pulse AMD Halo light bar by CPU/GPU temperature
After=halo-lp.service

[Service]
ExecStart=/usr/bin/python3 /usr/local/bin/halo-led-temp.py
# LED sysfs files are group-writable by halo-lp, so no root needed
DynamicUser=yes
SupplementaryGroups=halo-lp
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
